# Zerodha Kite Connect
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
KITE_ACCESS_TOKEN=your_daily_access_token  # regenerate each day

# ntfy (self-hosted via docker-compose)
NTFY_BASE_URL=        # public URL of the ntfy container
NTFY_TOPIC=            # topic name (must be granted access via ntfy CLI)
NTFY_TOKEN=      # Bearer token for the topic (create with: docker exec ntfy ntfy user add ...)

# App
APP_BASE_URL=       # must be publicly reachable for confirm/reject links
CONFIRMATION_SECRET=

# Per-order charge rates (equity delivery, NSE — May 2026)
# Override only if rates change; defaults in config.py are kept current
CHARGE_BROKERAGE=20
CHARGE_STT_RATE=0.001
CHARGE_ETC_RATE=0.0000322
CHARGE_SEBI_RATE=0.000001
CHARGE_IPFT_RATE=0.000001
CHARGE_GST_RATE=0.18
CHARGE_STAMP_RATE=0.00015
CHARGE_DP_FLAT=15.34
